# Copy to keystore.properties (gitignored) to sign local release builds.
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore release.keystore -alias emotion-tracker \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Keep release.keystore and its passwords out of git. Use Emotion Tracker's
# own key, not Soundboard's. This signs APKs and Play upload bundles; the
# installed Play certificate depends on your Play App Signing choice.
# See docs/deployment.md for F-Droid reproducible signing and CI environment variables.
storeFile=release.keystore
storePassword=
keyAlias=emotion-tracker
keyPassword=
